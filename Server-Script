local function moveSuites(plr)
	for _, suit in ipairs(plr.currentTurnSuites:GetChildren()) do
		local clone = suit:Clone()
		clone.Parent = plr.plrSuites
	end
	plr.currentTurnSuites:ClearAllChildren()
end
playerMove.OnServerEvent:Connect(function(plr, input)
	local playerRoll = plr.plrTurnInfo.playerRoll.Value
	if playerRoll > 0 then
		if firstLocation then
			plr.plrTurnInfo.plrInitialLocation.Value = plr.plrTurnInfo.plrSpace.Value
			firstLocation = false	
			playerMovement.location(plr, input)
		else
			playerMovement.location(plr, input)
		end
		
		if plr.plrTurnInfo.playerRoll.Value == 0 then
			endMovement:FireClient(plr)
		end
	end
	
end)



function endTurn(plr)
	
	
	endTurnEvent:FireClient(currentPlayer)
	
	if (plrList[currentTurn + 1]) then
		currentTurn += 1		
	else
		currentTurn = 1
		currentPlayer = plrList[currentTurn]
	end
	firstLocation = true
	currentPlayer = plrList[currentTurn]
	print(currentPlayer)
	startTurn:FireClient(currentPlayer)

end
	
	
